DATABASE_URL=sqlite:///./dev.db

# Required. There is deliberately no usable value to copy here: the app refuses to start
# without a JWT_SECRET of at least 32 characters, so generate your own instead of inventing
# one and paste that in.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#JWT_SECRET=
JWT_EXPIRE_HOURS=12
# Required, and deliberately left without a value to copy: the app refuses to start without it.
# On the first boot this value is hashed once with bcrypt and stored, and from then on the stored
# hash is the only staff credential - STAFF_PIN is never an accepted login again, so set your own
# and rotate it through POST /api/v1/auth/change-pin rather than treating this line as a password.
#STAFF_PIN=
DEFAULT_BRANCH_ID=1
CORS_ORIGINS=http://localhost:5173
ENV=development
