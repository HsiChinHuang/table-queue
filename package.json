{
  "name": "pi-agent-orchestrator",
  "version": "1.0.0",
  "description": "Multi-agent orchestration system for Pi Agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "launcher": "tsx launcher/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint launcher extensions scripts --ext .ts --fix",
    "lint:check": "eslint launcher extensions scripts --ext .ts",
    "validate-schemas": "tsx scripts/validate_schemas.ts",
    "validate-handoff": "tsx scripts/validate_handoff.ts",
    "test": "tsx --test"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "js-yaml": "^4.1.0",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "~5.3.0"
  }
}