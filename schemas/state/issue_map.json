{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-agent/schemas/state/issue_map.json",
  "title": "Issue Map",
  "description": "Mapping from local issue ID to platform issue number",
  "type": "object",
  "required": ["schema_version", "updated_at", "mappings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mappings": {
      "type": "object",
      "patternProperties": {
        "^t[0-9]+$": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}