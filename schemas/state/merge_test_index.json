{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-agent/schemas/state/merge_test_index.json",
  "title": "Merge Test Index",
  "description": "Cumulative test index for merged issues",
  "type": "object",
  "required": ["schema_version", "updated_at", "tests"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_id", "command"],
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^t[0-9]+$"
          },
          "command": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}