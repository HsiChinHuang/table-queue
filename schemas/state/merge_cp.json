{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-agent/schemas/state/merge_cp.json",
  "title": "Merge Checkpoint",
  "description": "Merge process checkpoint, used for recovery after interruption",
  "type": "object",
  "required": [
    "schema_version",
    "issue_id",
    "step",
    "state",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^t[0-9]+$"
    },
    "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "state": {
      "type": "string",
      "enum": ["fetched", "reset", "merged", "tested", "pushed", "closed"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "pre_merge_sha": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{7,40}$",
      "description": "SHA of main before the merge"
    },
    "merge_sha": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{7,40}$",
      "description": "SHA of the merge commit"
    },
    "test_result": {
      "type": ["object", "null"],
      "required": ["total", "passed", "failed"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}