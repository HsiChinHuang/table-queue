{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-agent/schemas/state/factpack.json",
  "title": "Factpack",
  "description": "Snapshot of frequently-read facts injected into Definer prompts. Reduces redundant file reads by the Definer. Generated by Orchestrator before each Definer spawn.",
  "type": "object",
  "required": ["schema_version", "subject_id", "phase", "created_at", "facts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^(t[0-9]+|phase_[0-9]+_[a-z_]+)$",
      "description": "Issue ID (t<N>) for groom/re_groom; milestone ID (phase_<n>_<name>) for survey"
    },
    "phase": {
      "type": "string",
      "enum": ["survey", "groom", "re_groom"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "facts": {
      "type": "object",
      "required": [
        "tech_stack",
        "commands_md",
        "coding_standards_md",
        "config_subset",
        "issue_map"
      ],
      "additionalProperties": false,
      "properties": {
        "tech_stack": {
          "type": ["string", "null"],
          "description": "Full text of the ## Tech stack section from docs/plan.md; fallback to docs/requirements.md; null if neither exists or the section is empty"
        },
        "commands_md": {
          "type": "string",
          "description": "Full text of docs/commands.md"
        },
        "coding_standards_md": {
          "type": "string",
          "description": "Full text of docs/coding_standards.md"
        },
        "config_subset": {
          "type": "object",
          "description": "Relevant config keys from config_snapshot.json (contract_first.*, limits.issue_granularity.*)",
          "additionalProperties": true
        },
        "issue_map": {
          "type": ["object", "null"],
          "description": "Content of docs/state/issue_map.json (mappings only). Non-null for survey, null for groom/re_groom"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "phase": { "const": "survey" } },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "facts": {
            "properties": {
              "issue_map": {
                "type": "object",
                "required": ["mappings"],
                "properties": {
                  "mappings": { "type": "object" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "phase": { "enum": ["groom", "re_groom"] } },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "facts": {
            "properties": {
              "issue_map": { "type": "null" }
            }
          }
        }
      }
    }
  ]
}