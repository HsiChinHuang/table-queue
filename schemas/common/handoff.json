{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-agent/schemas/common/handoff.json",
  "title": "Handoff",
  "description": "Base handoff envelope for all role outputs",
  "type": "object",
  "required": [
    "schema_version",
    "issue_id",
    "role",
    "phase",
    "status",
    "reached_state",
    "evidence",
    "artifacts",
    "error",
    "next_action",
    "timestamp",
    "retry_count"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^t[0-9]+$"
    },
    "role": {
      "type": "string",
      "enum": ["definer", "builder", "verifier"]
    },
    "phase": {
      "type": "string",
      "enum": [
        "survey", "review_plan", "groom", "re_groom",
        "implement", "fix_qa", "fix_merge", "fix_regression",
        "verify_issue", "verify_pre_merge", "verify_post_merge"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "FAIL", "BLOCKER"],
      "description": "COMPLETE = success; FAIL = retryable failure; BLOCKER = needs human"
    },
    "reached_state": {
      "type": "string",
      "enum": [
        "defined",
        "groomed",
        "built",
        "verified",
        "closed",
        "unchanged"
      ],
      "description": "unchanged = state unchanged due to failure"
    },
    "evidence": {
      "$ref": "evidence.json",
      "description": "Evidence supporting the state declaration"
    },
    "artifacts": {
      "type": "object",
      "required": ["files_written", "platform_issue", "output_path"],
      "additionalProperties": false,
      "properties": {
        "files_written": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files written, paths relative to project root"
        },
        "platform_issue": {
          "type": ["integer", "null"],
          "description": "Corresponding platform issue number"
        },
        "output_path": {
          "type": "string",
          "description": "Path to this handoff JSON file"
        }
      }
    },
    "error": {
      "oneOf": [
        { "$ref": "error.json" },
        { "type": "null" }
      ],
      "description": "Required (non-null) when status != COMPLETE; must be null when status == COMPLETE"
    },
    "next_action": {
      "oneOf": [
        {
          "type": "object",
          "required": ["role", "phase", "reason"],
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string",
              "enum": ["definer", "builder", "verifier"]
            },
            "phase": {
              "type": "string",
              "enum": [
                "survey", "review_plan", "groom", "re_groom",
                "implement", "fix_qa", "fix_merge", "fix_regression",
                "verify_issue", "verify_pre_merge", "verify_post_merge"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 10
            }
          }
        },
        { "type": "null" }
      ],
      "description": "Required (non-null) when status == FAIL; must be null otherwise"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Retry index (0 = first attempt)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "COMPLETE" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error": { "type": "null" },
          "next_action": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "FAIL" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error": { "type": "object" },
          "next_action": { "type": "object" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "BLOCKER" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "error": { "type": "object" },
          "next_action": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": { "const": "verifier" },
          "phase": { "const": "verify_issue" },
          "status": { "const": "FAIL" }
        },
        "required": ["role", "phase", "status"]
      },
      "then": {
        "properties": {
          "error": {
            "properties": {
              "error_type": { "const": "business_failure" },
              "context": {
                "required": ["failure_type"],
                "properties": {
                  "failure_type": {
                    "type": "string",
                    "enum": [
                      "implementation",
                      "ac_ambiguous",
                      "ac_wrong",
                      "test_env",
                      "test_quality"
                    ]
                  }
                }
              }
            }
          },
          "evidence": {
            "required": ["failure_type"],
            "properties": {
              "failure_type": {
                "type": "string",
                "enum": [
                  "implementation",
                  "ac_ambiguous",
                  "ac_wrong",
                  "test_env",
                  "test_quality"
                ]
              }
            }
          }
        }
      }
    }
  ]
}