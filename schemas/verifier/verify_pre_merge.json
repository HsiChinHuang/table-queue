{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-agent/schemas/verifier/verify_pre_merge.json",
  "title": "Verifier: Verify Pre-merge Output",
  "description": "Verifier verify_pre_merge mode output: pre-merge cumulative test verification",
  "allOf": [
    { "$ref": "../common/handoff.json" },
    {
      "type": "object",
      "properties": {
        "role": { "const": "verifier" },
        "phase": { "const": "verify_pre_merge" },
        "reached_state": { "enum": ["verified", "unchanged"] },
        "evidence": {
          "type": "object",
          "required": [
            "evidence_type",
            "cumulative_tests",
            "smoke_tests"
          ],
          "properties": {
            "evidence_type": { "const": "merge_verification" },
            "cumulative_tests": {
              "type": "object",
              "required": ["total", "passed", "failed"],
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 }
              }
            },
            "smoke_tests": {
              "type": "object",
              "required": ["total", "passed", "failed"],
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 }
              }
            },
            "failed_tests": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["test", "error_summary"],
                "additionalProperties": false,
                "properties": {
                  "test": { "type": "string" },
                  "error_summary": { "type": "string", "maxLength": 200 }
                }
              }
            }
          }
        }
      }
    }
  ]
}