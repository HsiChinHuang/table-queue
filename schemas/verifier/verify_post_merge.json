{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-agent/schemas/verifier/verify_post_merge.json",
  "title": "Verifier: Verify Post-merge Output",
  "description": "Verifier verify_post_merge mode output: post-merge smoke test verification",
  "allOf": [
    { "$ref": "../common/handoff.json" },
    {
      "type": "object",
      "properties": {
        "role": { "const": "verifier" },
        "phase": { "const": "verify_post_merge" },
        "reached_state": { "enum": ["verified", "unchanged"] },
        "evidence": {
          "type": "object",
          "required": [
            "evidence_type",
            "smoke_tests",
            "merge_sha"
          ],
          "properties": {
            "evidence_type": { "const": "merge_verification" },
            "smoke_tests": {
              "type": "object",
              "required": ["total", "passed", "failed"],
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 }
              }
            },
            "merge_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{7,40}$"
            },
            "regressions_detected": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["test", "previously_passed_at"],
                "additionalProperties": false,
                "properties": {
                  "test": { "type": "string" },
                  "previously_passed_at": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        }
      }
    }
  ]
}