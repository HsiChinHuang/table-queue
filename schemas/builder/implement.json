{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pi-agent/schemas/builder/implement.json",
  "title": "Builder: Implement Output",
  "description": "Builder implement mode output: implement AC, write tests, push branch",
  "allOf": [
    { "$ref": "../common/handoff.json" },
    {
      "type": "object",
      "properties": {
        "role": { "const": "builder" },
        "phase": { "const": "implement" },
        "reached_state": { "enum": ["built", "unchanged"] },
        "evidence": {
          "type": "object",
          "required": [
            "evidence_type",
            "branch",
            "branch_sha",
            "ac_mapping",
            "test_summary",
            "lint_status",
            "verification_commands_source"
          ],
          "properties": {
            "evidence_type": { "const": "build" },
            "branch": {
              "type": "string",
              "pattern": "^issue/t[0-9]+-[a-z0-9-]+$"
            },
            "branch_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{7,40}$"
            },
            "ac_mapping": {
              "type": "object",
              "patternProperties": {
                "^ac[0-9]+$": {
                  "type": "object",
                  "required": ["commit", "test", "verdict"],
                  "additionalProperties": false,
                  "properties": {
                    "commit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
                    "test": {
                      "type": "string",
                      "description": "Must come from docs/issues/<id>.md ## Verification commands"
                    },
                    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "MANUAL"] }
                  }
                }
              },
              "additionalProperties": false
            },
            "test_summary": {
              "type": "object",
              "required": ["total", "passed", "failed"],
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 }
              }
            },
            "lint_status": {
              "type": "string",
              "enum": ["CLEAN", "WARNINGS", "ERRORS"]
            },
            "verification_commands_source": {
              "type": "string",
              "const": "docs/issues/<id>.md#verification-commands",
              "description": "Authoritative source of verification commands"
            }
          }
        }
      }
    }
  ]
}