# ============================================================
# Project Config
# No secrets. No tokens. No API keys.
# YAML 1.2. Booleans: true/false only. UTF-8 no BOM.
# ============================================================

config_version: 2
timezone: UTC


# ============================================================
# Launcher
# ============================================================
launcher:
  auto_restart: true
  max_restart_attempts: 10
  backoff_seconds: [5, 15, 45, 120, 300]
  reset_on_scheduled_restart: true


# ============================================================
# Orchestrator
# ============================================================
orchestrator:
  scheduled_restart_enabled: false
  scheduled_restart_transitions: 20
  scheduled_restart_hours: 1
  context:
    refresh_interval_iterations: 10
    refresh_files:
      - AGENTS.md
      - skills/orchestrator/SKILL.md
  liveness:
    stale_minutes: 10
    force_release_multiplier: 2


# ============================================================
# Subagent watchdog (pi-subagents)
# ============================================================
subagent:
  watchdog:
    needs_attention_after_minutes: 15


# ============================================================
# Shared venv (Python read-only phases)
# ============================================================
venv:
  enabled: true
  cleanup_after_days: 30


# ============================================================
# Slots
# ============================================================
slots:
  max: 3
  pause_threshold: 2
  pause_threshold_min: 1
  pause_threshold_max: 5


# ============================================================
# Roles
# ============================================================
roles:
  definer:
    default_thinking: high
    max_retries: 3
    timeout_minutes: 60
    phases:
      survey:
        thinking: high
        max_retries: 2
        timeout_base_minutes: 15
        timeout_per_issue_minutes: 2
      review_plan:
        thinking: high
        max_retries: 2
      groom:
        thinking: medium
        max_retries: 3
      re_groom:
        thinking: medium
        max_retries: 3

  builder:
    default_thinking: high
    max_retries: 5
    timeout_minutes: 120
    phases:
      implement:
        thinking: high
        max_retries: 5
      fix_qa:
        thinking: high
        max_retries: 5
      fix_merge:
        thinking: medium
        max_retries: 3
      fix_regression:
        thinking: high
        max_retries: 3

  verifier:
    default_thinking: low
    max_retries: 3
    timeout_minutes: 60
    phases:
      verify_issue:
        thinking: low
        max_retries: 3
      verify_pre_merge:
        thinking: low
        max_retries: 2
      verify_post_merge:
        thinking: low
        max_retries: 2


# ============================================================
# Schema Validation
# ============================================================
schema:
  strict: true
  max_retries: 3
  validator_timeout_seconds: 10


# ============================================================
# Merge
# ============================================================
merge:
  dry_run: true
  full_suite_every: 10
  fast_path_lines: 10
  commit_message_max: 5000
  transactional: true
  smoke_tests_min: 10
  smoke_tests_max: 20


# ============================================================
# Git
# ============================================================
git:
  push_retry: 3
  push_backoff_seconds: [5, 15, 45]
  merge_fix_max_level: 3
  force_push_check: true
  worktree_retry: 3
  worktree_lock_backoff_seconds: 5
  main_history_track: true
  require_gpg: false
  autocrlf_uniform: true


# ============================================================
# Memory
# ============================================================
memory:
  read_max: 3
  promote_count: 2
  fail_delete_threshold: 3
  write_after_failures: 3
  pattern_threshold: 3
  similarity_dedupe: 0.85
  max_size_kb: 10
  max_candidates: 100
  retention_days: 90
  verified_retention_days: 365


# ============================================================
# Failure Patterns
# ============================================================
failure_patterns:
  enabled: true
  similarity_threshold: 0.8
  min_occurrences: 3


# ============================================================
# Contract-First Verification
# ============================================================
contract_first:
  enabled: true
  require_for: [backend, api, database]
  allow_natural_for: [ui, ux]


# ============================================================
# Output
# ============================================================
output:
  externalize_lines: 50
  externalize_tokens: 1000
  request_max_lines: 500
  diff_split_lines: 2000


# ============================================================
# Logging
# ============================================================
log:
  tail_lines: 100
  line_max_chars: 500
  rotation_time_utc: "00:05"
  dual_format_daily: true
  compress_after_days: 7
  monthly_after_days: 30
  quarterly_after_days: 365
  report_delay_hours: 12
  structured_wal: true


# ============================================================
# Retention
# ============================================================
retention:
  output_keep_days: 7
  output_archive_days: 30
  log_keep_days: 90
  daily_log_days: 30
  monthly_summary_days: 90
  quarterly_archive_days: 365
  config_history_keep: 10
  merge_history_days: 0
  failure_audit_days: 0
  metrics_days: 180
  status_metrics_days: 30
  idempotency_days: 7
  lint_cache_days: 7


# ============================================================
# Limits
# ============================================================
limits:
  dep_chain_warn: 10
  dep_chain_halt: 20
  comments_keep: 5
  history_max_lines: 1000
  pending_stale_days: 7
  stale_block_days: 7
  blocker_fatigue_count: 5
  similarity_threshold: 0.8
  ac_change_blocker_pct: 50
  analysis_max_per_day: 5
  issue_granularity:
    max_acs: 6
    max_files: 4
    max_diff_lines: 300
    warn_only: true


# ============================================================
# Priority
# ============================================================
priority:
  human_override_max: 3
  boost_value: 100
  starvation_warn_hours: 24
  starvation_blocker_hours: 48


# ============================================================
# Human Review
# ============================================================
human_review:
  stale_days: 7
  poll_interval_iterations: 1
  auto_close_after_days: 30


# ============================================================
# Automation
# ============================================================
automation:
  auto_recovery:
    enabled: true
    level: 4
    max_consecutive_failures: 5
  auto_skip_blocked: true
  auto_learn: true
  stall_detection:
    enabled: true
    iterations_threshold: 10
    action: write_report
  infinite_loop_detection:
    enabled: true
    max_same_failure: 5


# ============================================================
# Disk
# ============================================================
disk:
  warn_mb: 1000
  halt_mb: 100
  force_archive_mb: 500
  archive_free_ratio: 2.0


# ============================================================
# API
# ============================================================
api:
  page_size: 100
  cache_ttl_minutes: 5
  cache_force_on_error: true
  confirm_retries: 2
  confirm_gap_seconds: 5


# ============================================================
# Change log (append below)
# ============================================================
