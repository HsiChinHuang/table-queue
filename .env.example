# ============================================================
# Environment Variables — copy to .env and fill in
# DO NOT commit .env (contains secrets)
# ============================================================

# --- Required ---
PLATFORM=github
API_TOKEN=your_token_here
REPO_ID=owner/repo

# --- Optional ---
# API_URL=                      # self-hosted only
APPROVAL_MODE=full-auto         # full-auto | semi-auto | manual

# --- Overridable numerics (see _docs/config.md) ---
# Only allowed keys. Do not add arbitrary keys here.
MAX_SLOTS=3
SW_RETRY_PER_ROUND=25
SW_RETRY_PER_ISSUE=100
PM_RETRY_PER_ISSUE=4
QA_TIMEOUT_MINUTES=30
ORCH_RESTART_HOURS=1
ORCH_RESTART_TRANSITIONS=20