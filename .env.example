# ============================================================
# Environment Variables — copy to .env and fill in
# DO NOT commit .env (contains secrets)
# ============================================================

# --- Required ---
PLATFORM=github
API_TOKEN=your_token_here
REPO_ID=owner/repo

# --- Optional ---
# API_URL=                          # self-hosted only
APPROVAL_MODE=full-auto             # full-auto | semi-auto | manual

# --- Launcher 控制 ---
# LAUNCHER_AUTO_RESTART=true        # 崩潰後是否自動重啟
# LAUNCHER_MAX_RESTART_ATTEMPTS=10  # 0 = 不限制
# ORCH_SCHEDULED_RESTART=false      # Orchestrator 排程重啟
# ORCH_RESTART_HOURS=1
# ORCH_RESTART_TRANSITIONS=20

# --- Slots ---
# MAX_SLOTS=3